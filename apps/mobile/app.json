{
  "expo": {
    "name": "League Remote",
    "slug": "league-remote",
    "scheme": "leagueremote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070D17",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leagueremote.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "League Remote connects to the League Remote app on your PC over your Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.leagueremote.app",
      "adaptiveIcon": {
        "backgroundColor": "#070D17",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "League Remote uses the camera to scan the pairing QR code on your PC.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070D17",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0AC8B9",
          "defaultChannel": "match"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "71f4a650-ea96-4940-bfa9-fc2cb23b73b8"
      }
    },
    "owner": "mariosnik"
  }
}
