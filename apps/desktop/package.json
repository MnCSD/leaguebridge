{
  "name": "@league-remote/desktop",
  "productName": "League Remote",
  "version": "0.1.0",
  "private": true,
  "description": "Control the League of Legends client from your phone",
  "author": "Marios Nikolopoulos",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "dev:fake": "node scripts/electron-vite.mjs dev -- --league-path ../../.fake-league",
    "build": "node scripts/electron-vite.mjs build",
    "start": "node scripts/electron-vite.mjs preview",
    "dist": "node scripts/electron-vite.mjs build && node scripts/prepare-squirrel.cjs && node -e \"delete process.env.ELECTRON_RUN_AS_NODE; process.exit(require('child_process').spawnSync('npx', ['electron-builder', '--win'], { stdio: 'inherit', shell: true, env: process.env }).status)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawnSync(require('electron'), ['scripts/render-icon.cjs'], { stdio: 'inherit', env: process.env })\"",
    "splash": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; require('child_process').spawnSync(require('electron'), ['scripts/render-splash.cjs', ...process.argv.slice(1)], { stdio: 'inherit', env: process.env })\""
  },
  "//": "Everything is bundled into out/ at build time, so all packages are devDependencies: the installer ships no node_modules.",
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@league-remote/bridge-core": "*",
    "@league-remote/protocol": "*",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gifenc": "^1.0.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
